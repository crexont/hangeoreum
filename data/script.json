  "dialogues": {
    "intro": {
      "cast": ["jieun"],
      "start": "start",
      "nodes": {
        "start": {
          "lines": [
            { "who": "narration", "text": "띵동— 쉬는 시간 10분." },
            { "who": "jieun", "text": "다음 수업은 언덕 위 강의동! 서둘러야지." },
            { "who": "jieun", "text": "(계단으로 가면 금방인데… 바로 옆이 흡연구역이란 말이지.)" },
            { "who": "narration", "text": "화면을 터치한 곳으로 걸어가요. PC에서는 방향키도 돼요." }
          ],
          "next": null
        }
      }
    },

    "smoking_area": {
      "cast": ["jieun", "minwoo"],
      "start": "intro",
      "nodes": {
        "intro": {
          "lines": [
            { "who": "narration", "text": "계단 아래. 오른쪽 흡연구역에서 연기가 바람을 타고 계단 쪽으로 넘어온다." },
            { "who": "jieun", "if": "smelly", "text": "(벌써 옷에 냄새 밴 것 같은데…)" },
            { "who": "jieun", "text": "(또 이쪽으로 바람이 부네. 숨 참고 걸음 빠르게 지나가야 하나…)" },
            { "who": "jieun", "text": "(돌아가는 경사로도 있긴 한데, 거긴 너무 오래 걸려. 쉬는 시간 촉박한데.)" },
            { "who": "minwoo", "text": "(후… 연강이라 지금 아니면 못 피우는데.)" },
            { "who": "minwoo", "text": "(여기 지정 구역인데도, 지나가는 사람들이 자꾸 쳐다보네.)" }
          ],
          "choices": [
            { "text": "인상 쓰고 지나가기", "score": -1, "next": "frown" },
            { "text": "그냥 숨 참고 지나가기", "score": 0, "next": "hold" },
            { "text": "\"계단 쪽만 조금 피해주실 수 있을까요?\"", "score": 2, "set": ["asked"], "effect": "minwooMoves", "next": "ask" }
          ]
        },
        "frown": {
          "lines": [
            { "who": "narration", "text": "지은은 얼굴을 잔뜩 찌푸리고 민우 앞을 지나쳤다." },
            { "who": "minwoo", "text": "(…지정된 곳에서 피우는 건데. 왜 매번 죄지은 기분이지.)" },
            { "who": "minwoo", "text": "(피우는 사람만 일방적으로 다 양보하라는 건 좀 억울한데.)" },
            { "who": "narration", "text": "바람은 여전히 계단 쪽으로 분다." }
          ],
          "next": null
        },
        "hold": {
          "lines": [
            { "who": "jieun", "text": "(괜히 말 걸었다가 어색해지면 어떡해. 그냥 숨 참자. 흡—)" },
            { "who": "minwoo", "text": "(…방금 저 사람, 숨 참고 지나간 건가?)" },
            { "who": "narration", "text": "바람은 여전히 계단 쪽으로 분다." }
          ],
          "next": null
        },
        "ask": {
          "lines": [
            { "who": "jieun", "text": "저기… 혹시 계단 쪽만 조금 피해주실 수 있을까요? 바람이 그쪽으로 불어서요." },
            { "who": "minwoo", "text": "아, 연기가 계단까지 가요? 몰랐네요. 저 안쪽 구석으로 갈게요." },
            { "who": "minwoo", "text": "그래도 이렇게 말해주시니까 좋네요. 보통은 그냥 째려보고 가시거든요." },
            { "who": "jieun", "text": "앗, 감사합니다! 쉬는 시간 짧은데 편하게 피우세요." },
            { "who": "narration", "text": "민우가 흡연구역 안쪽 구석으로 자리를 옮겼다." }
          ],
          "next": null
        }
      }
    },

    "classroom": {
      "bg": "classroom",
      "cast": ["jieun", "neighbor"],
      "start": "arrive",
      "nodes": {
        "arrive": {
          "lines": [
            { "who": "narration", "if": "!late", "text": "강의실 도착! 겨우 자리에 앉았다." },
            { "who": "narration", "if": "late", "text": "강의실 도착… 이미 출석 부르는 중이었다. 살금살금 자리에 앉았다." },
            { "who": "jieun", "if": "late", "text": "(괜히 돌아왔나… 아냐, 연기 맡는 것보단 나았어.)" },
            { "who": "jieun", "if": "smelly", "text": "(킁킁… 혹시 나한테서도 담배 냄새 나나…?)" },
            { "who": "narration", "text": "그런데 옆자리 학생이 콜록, 콜록 하더니 슬쩍 한 칸 옆으로 자리를 옮긴다." },
            { "who": "jieun", "text": "…혹시 내 향수 때문인가?" },
            { "who": "jieun", "text": "(오늘 새로 산 거라 좀 넉넉하게 뿌렸는데…)" }
          ],
          "choices": [
            { "text": "\"향수 정도는 괜찮지 뭐\"", "score": 0, "next": "pov" },
            { "text": "\"다음엔 조금만 뿌려야겠다\"", "score": 2, "set": ["lessPerfume"], "next": "less" }
          ]
        },
        "pov": {
          "lines": [
            { "who": "narration", "effect": "povNeighbor", "text": "— 잠깐, 옆자리 학생의 시점 —" },
            { "who": "neighbor", "text": "(좋은 향이긴 한데… 머리가 띵하다.)" },
            { "who": "neighbor", "text": "(나 원래 향에 좀 예민하거든. 그렇다고 향수 뿌리지 말라고 할 수도 없고.)" },
            { "who": "neighbor", "text": "(…그냥 내가 한 칸 옮기자.)" },
            { "who": "narration", "effect": "povEnd", "text": "— 다시 지은의 시점 —" },
            { "who": "jieun", "text": "(자리 옮긴 건… 그냥 우연이겠지?)" }
          ],
          "next": null
        },
        "less": {
          "lines": [
            { "who": "jieun", "text": "(좋아하는 향이라도, 누군가한테는 불편할 수 있겠다.)" },
            { "who": "jieun", "text": "(다음엔 손목에 한 번만 뿌려야지.)" },
            { "who": "narration", "text": "지은은 옆 창문을 살짝 열었다. 시원한 바람이 들어온다." },
            { "who": "neighbor", "text": "(어, 바람 들어오니까 훨씬 낫다.)" },
            { "who": "neighbor", "text": "…고마워요." }
          ],
          "next": null
        }
      }
    }
  },

