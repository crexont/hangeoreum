  "dialogues": {
    "intro": {
      "cast": ["jieun"],
      "start": "start",
      "nodes": {
        "start": {
          "lines": [
            { "who": "narration", "text": "띵동— 쉬는 시간 10분." },
            { "who": "jieun", "text": "다음 수업은 언덕 위 강의동! 서둘러야지." },
            { "who": "jieun", "text": "(계단으로 가면 금방인데… 바로 옆이 흡연구역이란 말이지.)" },
            { "who": "narration", "text": "화면을 터치한 곳으로 걸어가요. PC에서는 방향키도 돼요." }
          ],
          "next": null
        }
      }
    },

    "smoking_area": {
      "cast": ["jieun", "minwoo"],
      "start": "intro",
      "nodes": {
        "intro": {
          "lines": [
            { "who": "narration", "text": "계단 아래. 오른쪽 흡연구역에서 연기가 바람을 타고 계단 쪽으로 넘어온다." },
            { "who": "jieun", "if": "smelly", "text": "(벌써 옷에 냄새 밴 것 같은데…)" },
            { "who": "jieun", "text": "(또 이쪽으로 바람이 부네. 숨 참고 걸음 빠르게 지나가야 하나…)" },
            { "who": "jieun", "text": "(돌아가는 경사로도 있긴 한데, 거긴 너무 오래 걸려. 쉬는 시간 촉박한데.)" },
            { "who": "minwoo", "text": "(후… 연강이라 지금 아니면 못 피우는데.)" },
            { "who": "minwoo", "text": "(여기 지정 구역인데도, 지나가는 사람들이 자꾸 쳐다보네.)" }
          ],
          "choices": [
            { "text": "인상 쓰고 지나가기", "score": -1, "set": ["frowned"], "next": "frown" },
            { "text": "그냥 숨 참고 지나가기", "score": 0, "next": "hold" },
            { "text": "\"계단 쪽만 조금 피해주실 수 있을까요?\"", "score": 2, "set": ["asked"], "effect": "minwooMoves", "next": "ask" }
          ]
        },
        "frown": {
          "lines": [
            { "who": "narration", "text": "지은은 얼굴을 잔뜩 찌푸리고 민우 앞을 지나쳤다." },
            { "who": "minwoo", "text": "(…지정된 곳에서 피우는 건데. 왜 매번 죄지은 기분이지.)" },
            { "who": "minwoo", "text": "(피우는 사람만 일방적으로 다 양보하라는 건 좀 억울한데.)" },
            { "who": "narration", "text": "바람은 여전히 계단 쪽으로 분다." }
          ],
          "next": null
        },
        "hold": {
          "lines": [
            { "who": "jieun", "text": "(괜히 말 걸었다가 어색해지면 어떡해. 그냥 숨 참자. 흡—)" },
            { "who": "minwoo", "text": "(…방금 저 사람, 숨 참고 지나간 건가?)" },
            { "who": "narration", "text": "바람은 여전히 계단 쪽으로 분다." }
          ],
          "next": null
        },
        "ask": {
          "lines": [
            { "who": "jieun", "text": "저기… 혹시 계단 쪽만 조금 피해주실 수 있을까요? 바람이 그쪽으로 불어서요." },
            { "who": "minwoo", "text": "아, 연기가 계단까지 가요? 몰랐네요. 저 안쪽 구석으로 갈게요." },
            { "who": "minwoo", "text": "그래도 이렇게 말해주시니까 좋네요. 보통은 그냥 째려보고 가시거든요." },
            { "who": "jieun", "text": "앗, 감사합니다! 쉬는 시간 짧은데 편하게 피우세요." },
            { "who": "narration", "text": "민우가 흡연구역 안쪽 구석으로 자리를 옮겼다." }
          ],
          "next": null
        }
      }
    },

